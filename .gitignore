node_modules
dist
.DS_Store
*.local

# cache intermediário do gerador de áudio (um mp3 por linha, por hash)
scripts/.cache.json
scripts/.cache/

# modelo neural do motor kokoro (~350 MB). Baixado do release do GitHub na
# primeira execução do gerar_audios.py; não faz sentido versionar.
scripts/.modelos/

# Os mp3 finais e o tempos.json FICAM no repositório de propósito: quem
# apresenta usa Chromebook e não tem terminal pra rodar o gerar_audios.py.
# public/audios.js continua fora — é a mesma coisa em base64, pesa o triplo e
# sai do build.
public/audios.js

# gerado por scripts/embutir_audios.py (camada A) — pesa dezenas de MB
public/audios.js
scripts/__pycache__/

# Trilha do combate do 3A. O arquivo fica de fora do repositório de propósito:
# a gravação usada hoje é obra de terceiro com direitos, e commitar mp3 assim
# transforma o repositório num ponto de distribuição. Quem apresenta copia o
# arquivo pro Chromebook junto do index.html. Sem ele, o combate roda em
# silêncio e o log de ativação avisa.
public/audio/sfx/Theme battle.mp3
