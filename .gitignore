node_modules
dist
.DS_Store
*.local

# cache intermediário do gerador de áudio (um mp3 por linha, por hash)
scripts/.cache.json
scripts/.cache/

# modelo neural do motor kokoro (~350 MB). Baixado do release do GitHub na
# primeira execução do gerar_audios.py; não faz sentido versionar.
scripts/.modelos/

# Os mp3 finais, o tempos.json e o public/audios.js FICAM no repositório de
# propósito: quem apresenta usa Chromebook e não tem terminal pra rodar o
# gerar_audios.py.
#
# O audios.js já esteve aqui, e foi um erro medido: sem ele, um clone limpo
# entrega um app com `camada A em 0/8`, `tempos reais em 0/8` e `sfx
# sintético` — ou seja, sem os tempos reais da legenda e sem as GRAVAÇÕES do
# hidrofone, que só chegam ao app embutidas. Os 5 MB em base64 são o preço de
# o build funcionar na mão de quem não tem terminal.
scripts/__pycache__/

# zip do build, gerado so pra entregar a pasta pronta a quem vai apresentar.
# E o dist/ compactado: conteudo gerado, e dist ja esta ignorado acima.
*.zip
